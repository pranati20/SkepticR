 "failure_modes": [
  {
   "title": "Hidden confounders pass",
   "detail": "If a decoy loads on a factor the Skeptic is not given (here VAL and MOM withheld), the confounder attack cannot see it. SkepticR only controls for factors it knows about.",
   "metric": "5 of 10 decoys declared DISCOVERY when VAL and MOM are hidden (vs 0 with full factors)"
  },
  {
   "title": "Weak real effects look like luck",
   "detail": "A real signal needs enough data to stand out from the best result luck can produce in a search of this size. Below that, SkepticR says LUCK or CAN'T TELL YET even when the effect is real. See the power curve.",
   "metric": "power curve: detection rate vs true Sharpe"
  },
  {
   "title": "Synthetic traps are caught from the spec",
   "detail": "In the synthetic benchmark leakage and survivorship are flagged in the hypothesis spec. On the market panel the Skeptic re-runs the strategy to find them from data. A leak hidden from both would pass.",
   "metric": "see equities demo for the data-driven version"
  },
  {
   "title": "Null-world validity depends on the null generator",
   "detail": "Block bootstrap keeps short-range dependence only. Long memory or regime structure the generator does not preserve can make p-values too optimistic.",
   "metric": "family-wise false alarm rate on pure noise with volatility regimes: 2% (nominal 5%)"
  },
  {
   "title": "Credibility budget can run dry",
   "detail": "Alpha-investing deliberately shrinks the level each round spends when the swarm keeps failing. A swarm with no real signals becomes more selective and eventually cannot declare anything, by design.",
   "metric": "see Credibility Meter"
  }
 ],
